{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doctore.local/schemas/training-dataset-manifest.schema.json",
  "title": "Doctore locked training dataset manifest",
  "description": "Content-addressed, immutable training dataset contract for one sport, market and feature domain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "sport",
    "competition",
    "market_type",
    "target_market",
    "period",
    "settlement_rules",
    "target_definition",
    "feature_schema_version",
    "created_at",
    "locked_at",
    "locked",
    "dataset_sha256",
    "row_count",
    "columns",
    "feature_columns",
    "target_column",
    "line_column",
    "over_odds_column",
    "under_odds_column",
    "timestamp_column",
    "sort_order"
  ],
  "properties": {
    "schema_version": {"const": "doctore.training-dataset.v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "sport": {"enum": ["MLB", "KBO", "NPB", "TENNIS", "SOCCER", "NBA", "WNBA", "NFL"]},
    "competition": {"type": "string", "minLength": 1},
    "market_type": {"type": "string", "minLength": 1},
    "target_market": {"type": "string", "minLength": 1},
    "period": {"type": "string", "minLength": 1},
    "settlement_rules": {"type": "string", "minLength": 1},
    "target_definition": {"type": "string", "minLength": 1},
    "feature_schema_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "locked_at": {"type": "string", "format": "date-time"},
    "locked": {"const": true},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "row_count": {"type": "integer", "minimum": 1},
    "columns": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "feature_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_column": {"type": "string", "minLength": 1},
    "line_column": {"type": "string", "minLength": 1},
    "over_odds_column": {"type": "string", "minLength": 1},
    "under_odds_column": {"type": "string", "minLength": 1},
    "timestamp_column": {"type": "string", "minLength": 1},
    "sort_order": {"const": "timestamp_strictly_ascending"},
    "source_manifest": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
