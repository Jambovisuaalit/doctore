{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doctore.local/schemas/mlb-pa-row.schema.json",
  "title": "Doctore canonical MLB plate appearance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "data_role", "source_name", "source_game_pk",
    "source_at_bat_index", "source_payload_sha256", "event_id",
    "plate_appearance_id", "official_date", "slate_id", "event_start_at",
    "play_start_at", "play_end_at", "game_number", "batter_id",
    "batter_name", "pitcher_id", "pitcher_name", "batting_team_id",
    "fielding_team_id", "inning", "half_inning", "outs_before",
    "batting_order_position", "pitcher_role", "batter_side", "pitcher_hand",
    "result_event", "result_event_type", "is_official_hit", "is_complete",
    "final_game_status", "extraction_generated_at"
  ],
  "properties": {
    "schema_version": {"const": "doctore.mlb-pa.v1"},
    "data_role": {"const": "settled_plate_appearance"},
    "source_name": {"type": "string", "minLength": 1},
    "source_game_pk": {"type": "integer", "minimum": 1},
    "source_at_bat_index": {"type": "integer", "minimum": 0},
    "source_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_id": {"type": "string", "pattern": "^mlb:[0-9]+$"},
    "plate_appearance_id": {"type": "string", "pattern": "^mlb:[0-9]+:ab:[0-9]+$"},
    "official_date": {"type": "string", "format": "date"},
    "slate_id": {"type": "string", "pattern": "^mlb-slate:[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "event_start_at": {"type": "string", "format": "date-time"},
    "play_start_at": {"type": ["string", "null"], "format": "date-time"},
    "play_end_at": {"type": ["string", "null"], "format": "date-time"},
    "game_number": {"type": "integer", "minimum": 1},
    "batter_id": {"type": "string", "pattern": "^mlbam:[0-9]+$"},
    "batter_name": {"type": "string"},
    "pitcher_id": {"type": "string", "pattern": "^mlbam:[0-9]+$"},
    "pitcher_name": {"type": "string"},
    "batting_team_id": {"type": "integer", "minimum": 1},
    "fielding_team_id": {"type": "integer", "minimum": 1},
    "inning": {"type": "integer", "minimum": 1},
    "half_inning": {"enum": ["top", "bottom"]},
    "outs_before": {"type": "integer", "minimum": 0, "maximum": 2},
    "batting_order_position": {"type": ["integer", "null"], "minimum": 1, "maximum": 9},
    "pitcher_role": {"enum": ["starter", "reliever"]},
    "batter_side": {"enum": ["L", "R", "S", ""]},
    "pitcher_hand": {"enum": ["L", "R", ""]},
    "result_event": {"type": "string"},
    "result_event_type": {"type": "string"},
    "is_official_hit": {"type": "boolean"},
    "is_complete": {"const": true},
    "final_game_status": {"type": "string", "minLength": 1},
    "extraction_generated_at": {"type": "string", "format": "date-time"}
  }
}
